# Bong2Subs Environment Configuration

# Hugging Face Access Token (Required for pyannote speaker diarization)
HF_TOKEN=

# LLM Translation APIs (Provide at least one, or system uses local translation fallback)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Speech Recognition (ASR) Configuration
# Provider: mimo (Xiaomi MiMo ASR 2.5 Cloud API) or faster-whisper (Local)
ASR_PROVIDER=mimo

# Xiaomi MiMo ASR 2.5 API Settings (https://mimo.mi.com/docs/en-US/quick-start/usage-guide/audio/Speech-Recognition)
MIMO_API_KEY=
# You can also supply multiple keys separated by commas for automatic rotation/failover:
MIMO_API_KEYS=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-asr

# Local faster-whisper Settings (used if ASR_PROVIDER=faster-whisper or as offline fallback)
# Models: large-v3, large-v2, medium, small, base, tiny
ASR_MODEL=small
# Device: auto, cpu, cuda
ASR_DEVICE=auto
# Compute type: int8 (fast on CPU), float16 (GPU), float32
ASR_COMPUTE_TYPE=int8
# Bengali language code
ASR_LANGUAGE=bn

# Speaker Diarization
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
ENABLE_DIARIZATION=true

# Subtitle Presentation Constraints
MAX_CPS=17
MAX_LINES=2
MAX_CHARS_PER_LINE=42
MIN_CUE_DURATION=1.0
MAX_CUE_DURATION=7.0

# QC & Hallucination Thresholds
# If speech overlap ratio < HALLUCINATION_HIGH_THRESHOLD, marked as HIGH risk
HALLUCINATION_HIGH_THRESHOLD=0.35
HALLUCINATION_MEDIUM_THRESHOLD=0.65
ASR_CONFIDENCE_LOW_THRESHOLD=0.60

# Server settings
API_HOST=127.0.0.1
API_PORT=8000
